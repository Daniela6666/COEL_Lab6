    - 400
- name: espectro_rx
  id: qtgui_freq_sink_x
  parameters:
    name: '"Espectro RX"'
    type: complex
    bw: samp_rate
    fc: freq
    fftsize: '2048'
    wintype: window.WIN_BLACKMAN_hARRIS
    average: '0.2'
    nconnections: '1'
    showports: 'False'
    update_time: '0.1'
    gui_hint: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0

    - 400
- name: tiempo_demod
  id: qtgui_time_sink_x
  parameters:
    name: '"Salida del demodulador"'
    type: float
    nconnections: '1'
    size: int(sps_dec*16)
    srate: fs_dec
    ymin: '-2'
    ymax: '2'
    update_time: '0.1'
    gui_hint: ''
    tr_mode: qtgui.TRIG_MODE_AUTO
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_level: '0'
    tr_delay: '0'
    tr_chan: '0'
    tr_tag: '""'
    autoscale: 'False'
    grid: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 760
    - 400
- name: a_audio
  id: rational_resampler_xxx
  parameters:
    type: fff
    interp: '6'
    decim: '25'
    taps: ''
    fractional_bw: '0'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: 200 kHz -> 48 kHz para el osciloscopio (M3)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled

options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: rx_fsk
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: RX FSK - RTL-SDR
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 8
    - 8
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '2000000'
    comment: Muestreo SDR [Hz]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 200
    - 12
- name: baud
  id: variable
  parameters:
    value: '2000'
    comment: Símbolos por segundo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 370
    - 12
- name: dev
  id: variable
  parameters:
    value: '25000'
    comment: Desviación de frecuencia ± [Hz]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 500
    - 12
- name: freq
  id: variable
  parameters:
    value: '433920000'
    comment: Portadora [Hz]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 630
    - 12
- name: sps
  id: variable
  parameters:
    value: int(samp_rate/baud)
    comment: Muestras por bit
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 800
    - 12
- name: nombre_prueba
  id: variable
  parameters:
    value: '"prueba01"'
    comment: CAMBIAR en cada corrida para no sobrescribir los archivos
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 200
    - 700
- name: carpeta
  id: variable
  parameters:
    value: '(lambda p: (os.makedirs(p, exist_ok=True), p)[1])(os.path.join(os.path.expanduser("~"),
      "lab6_pruebas", nombre_prueba))'
    comment: 'Carpeta de salida: C:/Users/<usuario>/lab6_pruebas/<nombre_prueba>'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 400
    - 700
- name: duracion_captura
  id: variable
  parameters:
    value: '5'
    comment: Segundos de IQ guardados
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 600
    - 700
- name: imports_registro
  id: import
  parameters:
    imports: 'import os

      import time

      import atexit

      import math'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 760
    - 700
- name: snippet_datos
  id: snippet
  parameters:
    section: main_after_init
    priority: '0'
    code: "def _valores():\n    return (f\"  Ganancia RF [dB]: {self.rf_gain}\\n\"\
      \n            f\"  Ganancia IF [dB]: {self.if_gain}\\n\"\n            f\"  Ganancia\
      \ BB [dB]: {self.bb_gain}\\n\"\n            f\"  Correccion de frecuencia [ppm]:\
      \ {self.ppm}\\n\")\n_inicio = _valores()\ndef _guardar_datos():\n    with open(os.path.join(self.carpeta,\
      \ \"datos_de_la_prueba.txt\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\
      Prueba: \" + str(self.nombre_prueba) + \"\\n\")\n        f.write(\"Lado: RX\
      \ (RTL-SDR)\\n\")\n        f.write(\"Fecha y hora de inicio: \" + _t0 + \"\\\
      n\")\n        f.write(f\"Frecuencia de muestreo [Hz]: {self.samp_rate}\\n\"\
      )\n        f.write(f\"Frecuencia central [Hz]: {self.freq}\\n\")\n        f.write(f\"\
      Baud: {self.baud}\\n\")\n        f.write(f\"Desviacion de frecuencia [Hz]: {self.dev}\\\
      n\")\n        f.write(\"Valores al iniciar:\\n\" + _inicio)\n        f.write(\"\
      Valores al terminar (los deslizadores pueden haber cambiado):\\n\" + _valores())\n\
      \        f.write(f\"Duracion de la captura IQ [s]: {self.duracion_captura}\\\
      n\")\n        f.write(\"Archivos: rx.cfile (IQ recibido), rx_bits.bin (bits\
      \ decodificados), datos_de_la_prueba.txt\\n\")\n_t0 = time.strftime(\"%Y-%m-%d\
      \ %H:%M:%S\")\n_guardar_datos()\natexit.register(_guardar_datos)\nprint(\"Archivos\
      \ de la prueba en:\", self.carpeta)"
    comment: Escribe datos_de_la_prueba.txt al iniciar y al terminar
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 920
    - 700
- name: if_gain
  id: variable
  parameters:
    value: '20'
    comment: Ganancia IF del RTL-SDR [dB]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 760
    - 80
- name: bb_gain
  id: variable
  parameters:
    value: '20'
    comment: Ganancia BB del RTL-SDR [dB]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 900
    - 80
- name: captura_head
  id: blocks_head
  parameters:
    type: complex
    num_items: int(samp_rate*duracion_captura)
    vlen: '1'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: Limita la grabacion a duracion_captura s
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 260
    - 540
- name: archivo_rx
  id: blocks_file_sink
  parameters:
    file: carpeta + "/rx.cfile"
    type: complex
    vlen: '1'
    append: 'False'
    unbuffered: 'False'
    affinity: ''
    alias: ''
    comment: IQ recibido (2 Msps, antes de filtrar)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 460
    - 540
- name: decim
  id: variable
  parameters:
    value: '10'
    comment: Decimación del filtro de canal
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 200
    - 80
- name: fs_dec
  id: variable
  parameters:
    value: samp_rate//decim
    comment: Muestreo tras decimar
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 330
    - 80
- name: sps_dec
  id: variable
  parameters:
    value: fs_dec/baud
    comment: Muestras por bit tras decimar
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 480
    - 80
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    label: Ganancia RF RTL [dB]
    gui_hint: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    stop: '49.6'
    step: '0.1'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 640
    - 80
- name: ppm
  id: variable_qtgui_range
  parameters:
    label: Corrección de frecuencia [ppm]
    gui_hint: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-60'
    stop: '60'
    step: '0.1'
    value: '0'
    widget: counter_slider
    comment: Ajustar hasta centrar los lóbulos del espectro
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 640
    - 150
- name: rtl
  id: osmosdr_source
  parameters:
    args: '"rtl=0"'
    freq0: freq
    gain0: rf_gain
    if_gain0: if_gain
    bb_gain0: bb_gain
    bw0: '0'
    corr0: ppm
    sample_rate: samp_rate
    nchan: '1'
    type: fc32
    gain_mode0: 'False'
    dc_offset_mode0: '0'
    iq_balance_mode0: '0'
    clock_source0: ''
    sync: ''
    num_mboards: '1'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: RTL-SDR NooElec
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 40
    - 260
- name: filtro_canal
  id: low_pass_filter
  parameters:
    type: fir_filter_ccf
    decim: decim
    gain: '1'
    samp_rate: samp_rate
    cutoff_freq: 2*dev+baud+10000
    width: '20000'
    win: window.WIN_HAMMING
    beta: '6.76'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: Corte = 2*dev + baud + margen para el offset del RTL
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 260
    - 260
- name: demod_fm
  id: analog_quadrature_demod_cf
  parameters:
    gain: fs_dec/(2*math.pi*dev)
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: 'Salida normalizada: ±1 = ±dev'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 520
    - 260
- name: sin_dc
  id: dc_blocker_xx
  parameters:
    type: ff
    length: int(sps_dec*20)
    long_form: 'True'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: Quita el error de frecuencia (RTL vs HackRF)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 760
    - 260
- name: reloj
  id: digital_clock_recovery_mm_xx
  parameters:
    type: float
    omega: sps_dec
    gain_omega: 0.25*0.175*0.175
    mu: '0.5'
    gain_mu: '0.175'
    omega_relative_limit: '0.005'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 980
    - 260
- name: decisor
  id: digital_binary_slicer_fb
  parameters:
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 1240
    - 260
- name: archivo_bits
  id: blocks_file_sink
  parameters:
    file: carpeta + "/rx_bits.bin"
    type: byte
    vlen: '1'
    append: 'False'
    unbuffered: 'True'
    affinity: ''
    alias: ''
    comment: Bits decodificados
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 1460
    - 260
- name: a_complejo
  id: blocks_float_to_complex
  parameters:
    vlen: '1'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: Parte imaginaria sin conectar = 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    rotation: 0
    state: enabled
    coordinate:
    - 1240
    - 400
- name: constelacion
  id: qtgui_const_sink_x
  parameters:
    name: '"Constelación (símbolos FSK)"'
    size: '1024'
    nconnections: '1'
    type: complex
    gui_hint: ''
    update_time: '0.1'
    xmin: '-2'
    xmax: '2'
    ymin: '-2'
    ymax: '2'
    axislabels: 'True'
    grid: 'True'
    comment: Dos grupos en I = -1 y +1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
